<Window x:Class="Tunnelman.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Tunnelman"
        xmlns:tunnels="clr-namespace:Tunnelman.Tunnels"
        Title="{Binding WindowTitle}"
        Height="620"
        Width="920"
        MinHeight="460"
        MinWidth="760"
        UseLayoutRounding="True"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        StateChanged="OnStateChanged"
        SourceInitialized="OnSourceInitialized"
        Closing="OnClosing">
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{x:Static local:MainWindow.AddTunnelCommand}"/>
        <KeyBinding Gesture="Ctrl+E" Command="{x:Static local:MainWindow.ExportCommand}"/>
        <KeyBinding Gesture="Ctrl+I" Command="{x:Static local:MainWindow.ImportCommand}"/>
        <KeyBinding Key="Escape" Command="{x:Static local:MainWindow.HideCommand}"/>
    </Window.InputBindings>
    <DockPanel Background="{StaticResource BgBrush}">
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <DockPanel>
                <Button x:Name="ProfileButton"
                        DockPanel.Dock="Right"
                        Style="{StaticResource StatusIconButton}"
                        Margin="8,0,0,0"
                        Click="OnOpenProfileClick">
                    <TextBlock Style="{StaticResource GlyphSmall}" Text="&#xED25;"/>
                </Button>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Margin="16" Background="{StaticResource BgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Button Style="{StaticResource PrimaryButton}" Click="OnAddClick" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;"/>
                        <TextBlock Text="Add tunnel" Margin="4,0,0,0" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ExportButton"
                            Command="{x:Static local:MainWindow.ExportCommand}"
                            Margin="0,0,8,0"
                            ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE898;"/>
                            <TextBlock Text="Export" Margin="4,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Static local:MainWindow.ImportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;"/>
                            <TextBlock Text="Import" Margin="4,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <ListBox x:Name="TunnelList"
                         ItemsSource="{Binding Tunnels}"
                         Visibility="{Binding HasTunnels, Converter={StaticResource BoolToVis}}"
                         AllowDrop="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         DragOver="OnTunnelDragOver"
                         DragLeave="OnTunnelDragLeave"
                         Drop="OnTunnelDrop">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type tunnels:TunnelItem}">
                            <Border Padding="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="&#xE700;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"
                                               Cursor="SizeAll"
                                               ToolTip="Drag to reorder"
                                               PreviewMouseLeftButtonDown="OnGripDown"
                                               PreviewMouseMove="OnGripMove"
                                               PreviewMouseLeftButtonUp="OnGripUp"
                                               QueryContinueDrag="OnGripQueryContinue">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ToggleButton Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding Enabled, Mode=OneWay}"
                                                  IsEnabled="{Binding CanToggle}"
                                                  Click="OnToggleClick"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  ToolTip="{Binding StatusText}"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <local:PackLeftPanel Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ListenText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Cursor="Hand"
                                                       PreviewMouseLeftButtonDown="OnListenCopy"/>
                                            <TextBlock Text="&#xE76C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Margin="6,0"/>
                                            <TextBlock local:PackLeftPanel.IsFill="True"
                                                       Text="{Binding RemoteText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Cursor="Hand"
                                                       TextTrimming="CharacterEllipsis"
                                                       PreviewMouseLeftButtonDown="OnRemoteCopy"/>
                                        </local:PackLeftPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Direct"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   Visibility="{Binding IsDirect, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="&#xE12B;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   ToolTip="{Binding ProxyText}"
                                                   Visibility="{Binding HasProxy, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource RowButton}" Click="OnLogClick"
                                                ToolTip="Log" Margin="0,0,6,0">
                                            <TextBlock Style="{StaticResource GlyphSmall}" Text="&#xF000;"/>
                                        </Button>
                                        <Button Style="{StaticResource RowButton}" Click="OnEditClick"
                                                IsEnabled="{Binding CanMutate}"
                                                ToolTip="Edit" Margin="0,0,6,0">
                                            <TextBlock Style="{StaticResource GlyphSmall}" Text="&#xE70F;"/>
                                        </Button>
                                        <Button Style="{StaticResource RowDangerButton}" Click="OnDeleteClick"
                                                IsEnabled="{Binding CanMutate}"
                                                ToolTip="Delete">
                                            <TextBlock Style="{StaticResource GlyphSmall}" Text="&#xE74D;"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="32">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowNoTunnelsHint}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                        <TextBlock Style="{StaticResource GlyphLarge}" Text="&#xE968;"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="No tunnels" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Add a tunnel, or import a file. Enabled tunnels start listening."
                                   Foreground="{StaticResource MutedBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <Button Command="{x:Static local:MainWindow.ImportCommand}"
                                HorizontalAlignment="Center"
                                Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;"/>
                                <TextBlock Text="Import from file" Margin="4,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
