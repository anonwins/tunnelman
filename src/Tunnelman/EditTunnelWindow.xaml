<Window x:Class="Tunnelman.EditTunnelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tunnel"
        Width="520"
        MinWidth="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SourceInitialized="OnSourceInitialized">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="80"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal">
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE968;" FontSize="20"
                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Text="New tunnel" FontSize="16" FontWeight="SemiBold"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Label Grid.Row="2" Content="Name" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="NameBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,10"/>

        <Label Grid.Row="3" Content="Remote" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="RemoteHostBox" Grid.Row="3" Grid.Column="1" Margin="0,0,8,10"/>
        <TextBox x:Name="RemotePortBox" Grid.Row="3" Grid.Column="2" Margin="0,0,0,10"/>

        <Label Grid.Row="4" Content="Listen" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="ListenAddressBox" Grid.Row="4" Grid.Column="1" Margin="0,0,8,10"/>
        <TextBox x:Name="ListenPortBox" Grid.Row="4" Grid.Column="2" Margin="0,0,0,10"/>

        <Label Grid.Row="5" Content="SOCKS5" VerticalAlignment="Center" Margin="0,0,0,10"/>
        <TextBox x:Name="SocksHostBox" Grid.Row="5" Grid.Column="1" Margin="0,0,8,10"/>
        <TextBox x:Name="SocksPortBox" Grid.Row="5" Grid.Column="2" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                   Text="SOCKS5 is optional. Leave it empty to connect directly from this PC."
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,0"/>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button IsCancel="True" MinWidth="96" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;"/>
                    <TextBlock Text="Cancel" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSaveClick" MinWidth="96">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;"/>
                    <TextBlock Text="Save" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
